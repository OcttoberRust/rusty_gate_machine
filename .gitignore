#Ignore Rust build files and dependencies
/target/
/Cargo.lock

#Ignore Rust debug and release builds
/debug/
/release/

#Ignore database migrations build artifacts (Diesel, sqlx)
/migrations/**/down.sql
/migrations/**/up.sql

#Ignore Node.js dependencies and build files (React frontend)
/frontend/node_modules/
/frontend/dist/
/frontend/.next/
/frontend/.vercel/
/frontend/.netlify/

#Ignore environment and configuration files
.env
.env.local
.env.development
.env.production
/secrets.json
/config.json

#Ignore logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.swp
*.swo
.DS_Store
Thumbs.db

#Ignore Terraform build state files
/infra/terraform/.terraform/
/infra/terraform/terraform.tfstate*
/infra/terraform/.terraform.lock.hcl

#Ignore Docker-related files
docker-compose.override.yml
**/docker-compose.override.yml
/tmp/
.vscode/

#Ignore AWS credentials and secrets
.aws/
*.pem
*.key
.*crt

#Ignore GitHub Actions workflow logs
/*github/workflows/*.log
